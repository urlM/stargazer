<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Stargazer{% endblock %}</title>
        <style>
            :root {
                color-scheme: light;
                --paper: #f7f1e8;
                --mist: #dfe7f2;
                --ink: #1a2430;
                --muted: #5d6774;
                --line: rgba(26, 36, 48, 0.14);
                --panel: rgba(255, 255, 255, 0.86);
                --panel-strong: rgba(255, 255, 255, 0.94);
                --accent: #b4542a;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Georgia, "Times New Roman", serif;
                color: var(--ink);
                background:
                    radial-gradient(circle at top, rgba(180, 84, 42, 0.12), transparent 32%),
                    linear-gradient(135deg, var(--paper) 0%, var(--mist) 100%);
            }

            a {
                color: inherit;
            }

            .shell {
                width: min(1040px, calc(100% - 2rem));
                margin: 4rem auto;
                padding: 2.5rem;
                background: var(--panel);
                border: 1px solid var(--line);
                box-shadow: 0 24px 60px rgba(26, 36, 48, 0.12);
            }

            .eyebrow {
                margin: 0 0 0.75rem;
                color: var(--accent);
                font-size: 0.95rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            h1 {
                margin: 0 0 1rem;
                font-size: clamp(2.2rem, 5vw, 4rem);
                line-height: 0.95;
            }

            p {
                margin: 0 0 1rem;
                color: var(--muted);
                font-size: 1.05rem;
                line-height: 1.7;
            }

            code {
                display: inline-block;
                max-width: 100%;
                overflow-wrap: anywhere;
                padding: 0.2rem 0.45rem;
                background: rgba(26, 36, 48, 0.06);
                border-radius: 0.35rem;
                font-size: 0.95rem;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 2rem;
                background: var(--panel-strong);
            }

            th,
            td {
                padding: 1rem;
                border-bottom: 1px solid var(--line);
                text-align: left;
                vertical-align: top;
            }

            th {
                font-size: 0.82rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--muted);
            }

            .empty-state {
                margin-top: 2rem;
                padding: 1.5rem;
                border: 1px dashed var(--line);
                background: rgba(255, 255, 255, 0.65);
            }

            .stars {
                white-space: nowrap;
                font-weight: 700;
            }

            @media (max-width: 720px) {
                .shell {
                    margin: 1.5rem auto;
                    padding: 1.5rem;
                }

                table,
                thead,
                tbody,
                tr,
                th,
                td {
                    display: block;
                }

                thead {
                    display: none;
                }

                tr {
                    margin-bottom: 1rem;
                    border: 1px solid var(--line);
                    background: var(--panel-strong);
                }

                td {
                    border-bottom: none;
                    padding: 0.85rem 1rem;
                }
            }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
