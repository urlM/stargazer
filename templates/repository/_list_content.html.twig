{% set list_state = { search: search, page: page, sort: sort, direction: direction, star_range: selected_star_range|default('all'), max_repositories: selected_max_repositories|default(100) } %}
{% set name_direction = sort == 'name' and direction == 'asc' ? 'desc' : 'asc' %}
{% set stars_direction = sort == 'stars' and direction == 'desc' ? 'asc' : 'desc' %}
{% set fragment_mode = fragment_mode|default(false) %}
{% if next_page_path is not defined %}
    {% set next_page_path = pagerfanta is not null and pagerfanta.hasNextPage ? path('app_repository_index', list_state|merge({page: pagerfanta.nextPage})) : '' %}
{% endif %}
<div data-infinite-content>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" aria-sort="{{ sort == 'name' ? (direction == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                        <a
                            href="{{ path('app_repository_index', list_state|merge({sort: 'name', direction: name_direction})) }}"
                            class="link-body-emphasis text-decoration-none"
                        >
                            Repository Name
                            {% if sort == 'name' %}
                                <span aria-hidden="true">{% if direction == 'asc' %}&uarr;{% else %}&darr;{% endif %}</span>
                                <span class="visually-hidden">sorted {{ direction == 'asc' ? 'ascending' : 'descending' }}</span>
                            {% endif %}
                        </a>
                    </th>
                    <th scope="col" aria-sort="{{ sort == 'stars' ? (direction == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                        <a
                            href="{{ path('app_repository_index', list_state|merge({sort: 'stars', direction: stars_direction})) }}"
                            class="link-body-emphasis text-decoration-none"
                        >
                            Stars
                            {% if sort == 'stars' %}
                                <span aria-hidden="true">{% if direction == 'asc' %}&uarr;{% else %}&darr;{% endif %}</span>
                                <span class="visually-hidden">sorted {{ direction == 'asc' ? 'ascending' : 'descending' }}</span>
                            {% endif %}
                        </a>
                    </th>
                </tr>
            </thead>
            <tbody data-repository-rows>
                {% include 'repository/_rows.html.twig' %}
            </tbody>
        </table>
    </div>

    {% if fragment_mode %}
        <div data-pagination data-next-page-url="{{ next_page_path }}"></div>
    {% elseif pagerfanta.nbPages > 1 %}
        <nav class="mt-4" aria-label="Pagination" data-pagination data-next-page-url="{{ next_page_path }}">
            <ul class="pagination justify-content-center">
                {% if pagerfanta.hasPreviousPage %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('app_repository_index', list_state|merge({page: pagerfanta.previousPage})) }}">Previous</a>
                    </li>
                {% else %}
                    <li class="page-item disabled">
                        <span class="page-link">Previous</span>
                    </li>
                {% endif %}

                {% for page in 1..pagerfanta.nbPages %}
                    {% if page == pagerfanta.currentPage %}
                        <li class="page-item active" aria-current="page">
                            <span class="page-link">{{ page }}</span>
                        </li>
                    {% else %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_repository_index', list_state|merge({page: page})) }}">{{ page }}</a>
                        </li>
                    {% endif %}
                {% endfor %}

                {% if pagerfanta.hasNextPage %}
                    <li class="page-item">
                        <a class="page-link" href="{{ next_page_path }}">Next</a>
                    </li>
                {% else %}
                    <li class="page-item disabled">
                        <span class="page-link">Next</span>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% else %}
        <div data-pagination data-next-page-url=""></div>
    {% endif %}

    <div class="mt-3 small text-muted" data-infinite-status aria-live="polite"></div>
    <div class="alert alert-warning mt-3 d-none" data-infinite-error role="status"></div>
    <div class="repository-scroll-sentinel" data-infinite-sentinel {% if next_page_path == '' %}hidden{% endif %}></div>
</div>
