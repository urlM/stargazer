{% extends 'base.html.twig' %}

{% block title %}Top PHP Repositories{% endblock %}

{% block body %}
<main class="brand-shell">
    {% set list_state = { search: search, page: page, sort: sort, direction: direction } %}
    {% set name_direction = sort == 'name' and direction == 'asc' ? 'desc' : 'asc' %}
    {% set stars_direction = sort == 'stars' and direction == 'desc' ? 'asc' : 'desc' %}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <p class="eyebrow">Repository Browser</p>
            <h1 class="mb-0">Top Starred PHP Repositories</h1>
        </div>
        <form action="{{ path('app_repository_refresh') }}" method="POST">
            <input type="hidden" name="_token" value="{{ csrf_token('refresh') }}">
            <input type="hidden" name="search" value="{{ search }}">
            <input type="hidden" name="page" value="{{ page }}">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="direction" value="{{ direction }}">
            <button type="submit" class="btn btn-primary">Refresh Data</button>
        </form>
    </div>

    {% set flashes = app.flashes %}
    {% if flashes is not empty %}
        <section class="mb-4" aria-live="polite">
            {% for label, messages in flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </section>
    {% endif %}

    <!-- Search Form -->
    <div class="mb-4">
        <form method="GET" action="{{ path('app_repository_index') }}" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search repositories..." value="{{ search }}">
            <input type="hidden" name="page" value="{{ page }}">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="direction" value="{{ direction }}">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            {% if search %}
                <a href="{{ path('app_repository_index', {page: page, sort: sort, direction: direction}) }}" class="btn btn-outline-secondary">Clear</a>
            {% endif %}
        </form>
    </div>

    <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th scope="col" aria-sort="{{ sort == 'name' ? (direction == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                    <a
                        href="{{ path('app_repository_index', list_state|merge({sort: 'name', direction: name_direction})) }}"
                        class="link-body-emphasis text-decoration-none"
                    >
                        Repository Name
                        {% if sort == 'name' %}
                            <span aria-hidden="true">{% if direction == 'asc' %}&uarr;{% else %}&darr;{% endif %}</span>
                            <span class="visually-hidden">sorted {{ direction == 'asc' ? 'ascending' : 'descending' }}</span>
                        {% endif %}
                    </a>
                </th>
                <th scope="col" aria-sort="{{ sort == 'stars' ? (direction == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                    <a
                        href="{{ path('app_repository_index', list_state|merge({sort: 'stars', direction: stars_direction})) }}"
                        class="link-body-emphasis text-decoration-none"
                    >
                        Stars
                        {% if sort == 'stars' %}
                            <span aria-hidden="true">{% if direction == 'asc' %}&uarr;{% else %}&darr;{% endif %}</span>
                            <span class="visually-hidden">sorted {{ direction == 'asc' ? 'ascending' : 'descending' }}</span>
                        {% endif %}
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            {% for repo in repositories %}
                <tr>
                    <td>
                        <a href="{{ path('app_repository_show', {id: repo.id}) }}">{{ repo.name }}</a>
                    </td>
                    <td>{{ repo.stars|number_format }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">No repositories found. {% if search %}Try a different search.{% else %}Please run a sync.{% endif %}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>

    <!-- Pagination -->
    {% if pagerfanta.nbPages > 1 %}
    <nav class="mt-4" aria-label="Pagination">
        <ul class="pagination justify-content-center">
            {% if pagerfanta.hasPreviousPage %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_repository_index', list_state|merge({page: pagerfanta.previousPage})) }}">Previous</a>
                </li>
            {% else %}
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            {% endif %}

            {% for page in 1..pagerfanta.nbPages %}
                {% if page == pagerfanta.currentPage %}
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">{{ page }}</span>
                    </li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('app_repository_index', list_state|merge({page: page})) }}">{{ page }}</a>
                    </li>
                {% endif %}
            {% endfor %}

            {% if pagerfanta.hasNextPage %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_repository_index', list_state|merge({page: pagerfanta.nextPage})) }}">Next</a>
                </li>
            {% else %}
                <li class="page-item disabled">
                    <span class="page-link">Next</span>
                </li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}
</main>
{% endblock %}
