{% extends 'base.html.twig' %}

{% block title %}Top PHP Repositories{% endblock %}

{% block body %}
<div class="container">
    <h1>Top Starred PHP Repositories</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Repository Name</th>
                <th>Stars</th>
            </tr>
        </thead>
        <tbody>
            {% for repo in repositories %}
                <tr>
                    <td>
                        <a href="{{ repo.url }}" target="_blank">{{ repo.name }}</a>
                    </td>
                    <td>{{ repo.stars|number_format }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">No repositories found in the database. Please run a sync.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}