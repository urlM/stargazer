{% extends 'base.html.twig' %}

{% block title %}Top PHP Repositories{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h1>Top Starred PHP Repositories</h1>
        <form action="{{ path('app_repository_refresh') }}" method="POST">
            <input type="hidden" name="_token" value="{{ csrf_token('refresh') }}">
            <button type="submit" class="btn btn-primary">Refresh Data</button>
        </form>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <table class="table">
        <thead>
            <tr>
                <th>Repository Name</th>
                <th>Stars</th>
            </tr>
        </thead>
        <tbody>
            {% for repo in repositories %}
                <tr>
                    <td>
                        <a href="{{ repo.url }}" target="_blank">{{ repo.name }}</a>
                    </td>
                    <td>{{ repo.stars|number_format }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">No repositories found in the database. Please run a sync.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}