{% extends 'base.html.twig' %}

{% block title %}Top PHP Repositories{% endblock %}

{% block body %}
<main class="brand-shell">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <p class="eyebrow">Repository Browser</p>
            <h1 class="mb-0">Top Starred PHP Repositories</h1>
        </div>
        <form action="{{ path('app_repository_refresh') }}" method="POST">
            <input type="hidden" name="_token" value="{{ csrf_token('refresh') }}">
            <input type="hidden" name="search" value="{{ search }}">
            <input type="hidden" name="page" value="{{ page }}">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="direction" value="{{ direction }}">
            <div class="d-flex flex-column flex-sm-row gap-2">
                <select name="star_range" class="form-select">
                    {% for value, label in star_range_choices %}
                        <option value="{{ value }}" {% if value == selected_star_range %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
                <select name="max_repositories" class="form-select">
                    {% for value in max_repository_choices %}
                        <option value="{{ value }}" {% if value == selected_max_repositories %}selected{% endif %}>Up to {{ value|number_format }} repos</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-primary">Refresh Data</button>
            </div>
        </form>
    </div>

    {% set flashes = app.flashes %}
    {% if flashes is not empty %}
        <section class="mb-4" aria-live="polite">
            {% for label, messages in flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </section>
    {% endif %}

    <div class="mb-4">
        <form method="GET" action="{{ path('app_repository_index') }}" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search repositories..." value="{{ search }}">
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="direction" value="{{ direction }}">
            <input type="hidden" name="star_range" value="{{ selected_star_range }}">
            <input type="hidden" name="max_repositories" value="{{ selected_max_repositories }}">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            {% if search %}
                <a href="{{ path('app_repository_index', {page: 1, sort: sort, direction: direction, star_range: selected_star_range, max_repositories: selected_max_repositories}) }}" class="btn btn-outline-secondary">Clear</a>
            {% endif %}
        </form>
    </div>

    <section id="repository-listing">
        {% include 'repository/_list_content.html.twig' %}
    </section>
</main>
{% endblock %}
